 },
 "sensitiveFieldName": "/token|key|secret|email|cookie|auth|password|session/i",
 "publicChainFieldNames": ["token", "tokenId", "tokenIds", "tokens"],
 "bulkyFieldNames": {
  "snap": "order-book dump",
  "book": "order-book dump",
  "listings": "order-book dump",
  "offers": "order-book dump",
  "tail": "process output (paths, stack traces)",
  "resp": "raw API response",
  "text": "verbatim third-party post (the url is kept)",
  "host": "the operator's server address"
 },
 "txHashFields": ["tx", "hash"],
 "txHashListFields": ["txs"],
 "redactLocalPaths": true,
 "localPathRoots": ["root", "home", "tmp", "var", "etc", "usr", "opt", "run"]
}
