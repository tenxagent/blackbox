  "money": ["live", "tx", "lp_mint", "lp_exit", "lp_recenter", "free_mint", "fill", "stub_offer"],
  "refusal": ["skip", "fire_refused", "flock_skip", "mintarm_skip", "stub_pause", "arm_gave_up", "qcwatch_end"],
  "alert": ["alert"],
  "sim": ["flock_sim", "poke_dry_done", "crank_dry_done", "mintarm_dry_done", "crank_rehearsal_done"],
  "paper": ["paper", "ladder", "metaculus_forecast"],
  "arming": ["armed", "arm_wait", "mintarm_armed", "mintarm_signed", "mintarm_moved", "mintarm_t60", "mintarm_build", "mint_sell_wait", "crank_armed", "crank_signed", "crank_remote", "poke_armed"],
  "lifecycle": ["start", "metaculus_watch_start", "merkl_radar_start"],
  "application": ["wl", "wl_apply"]
 },
 "privacyEngines": {
  "kleos-side": "operator side-wallet activity, not the agent"
 },
 "excludedAddressHashesFile": "data/excluded-address-hashes.json",
 "reduceEngines": {
